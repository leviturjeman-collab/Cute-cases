# ── Base de datos (PostgreSQL — §12.1) ──────────────────────────────────────
# Desarrollo local (docker compose up -d): ambas URLs iguales.
DATABASE_URL="postgresql://cutecases:cutecases@localhost:5432/cutecases"
DIRECT_URL="postgresql://cutecases:cutecases@localhost:5432/cutecases"

# Supabase (cuando se conecte; Project Settings → Database):
#   DATABASE_URL = URL del "Transaction pooler" (puerto 6543) + ?pgbouncer=true
#     p. ej. postgresql://postgres.<ref>:<pass>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL   = URL de "Direct connection" (puerto 5432), usada solo por
#                  prisma migrate / db push
#     p. ej. postgresql://postgres.<ref>:<pass>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Auth.js / NextAuth ──────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-largo"

# OAuth Google (opcional; sin esto funciona el login por email)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple (opcional)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Storage S3-compatible (miniaturas y assets — fase de integración;
# Supabase Storage expone endpoint S3-compatible si se quiere usar)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
