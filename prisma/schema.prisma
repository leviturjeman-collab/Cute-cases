// Cute Cases v4 — modelo de datos (§12)
// Convenciones (D8): ids cuid(), dinero Int en céntimos, longitudes Float en mm,
// timestamps UTC automáticos, borrado físico salvo donde se indica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: DATABASE_URL = pooler (6543, ?pgbouncer=true); DIRECT_URL = 5432.
  directUrl = env("DIRECT_URL")
}

model DeviceModel {
  id             String  @id @default(cuid())
  tipo           String  @default("iphone") // preparado para ipad/macbook/airpods
  slug           String  @unique // "iphone-15-pro"
  nombre         String
  generacion     String
  anchoMm        Float
  altoMm         Float
  radioEsquinaMm Float
  grosorMm       Float   @default(2.5)
  cameraZone     Json // [{x,y}...] mm
  moduloForma    String // alimenta el SVG identificador (§6.2)
  asset3dUrl     String? // null => paramétrica (D5)
  activo         Boolean @default(false)

  compat    CaseCompatibility[]
  designs   Design[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model CaseBase {
  id          String  @id @default(cuid())
  slug        String  @unique
  nombre      String
  descripcion String
  material    String // silicona|transparente|rigida|rigida-perlada
  fotos       Json // rutas de renders §10.5
  asset3dUrl  String?
  activo      Boolean @default(false)
  destacada   Boolean @default(false)

  variantes CaseVariant[]
  compat    CaseCompatibility[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model CaseCompatibility {
  caseId   String
  deviceId String
  case     CaseBase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  device   DeviceModel @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([caseId, deviceId])
}

model CaseVariant {
  id             String   @id @default(cuid())
  caseBaseId     String
  caseBase       CaseBase @relation(fields: [caseBaseId], references: [id], onDelete: Cascade)
  colorNombre    String
  colorHex       String
  foto           String?
  precioCentimos Int
  disponible     Boolean  @default(true)

  designs Design[]

  @@index([caseBaseId])
}

model Element {
  id             String  @id @default(cuid())
  slug           String  @unique
  nombre         String
  tipo           String // charm3d | plano
  categoria      String // letras|corazones|lazos|flores|frutas|animales|estrellas|cadenas
  precioCentimos Int
  anchoMm        Float
  altoMm         Float
  profundidadMm  Float?
  recipe         String? // RecipeId procedural (D5)
  recipeParams   Json?
  assetUrl       String? // GLB futuro; prioridad sobre recipe
  hitbox         Json // [[{x,y}...], ...] convexos, origen centro
  acabado        String // metal-oro|metal-plata|esmalte|cristal|nacar|vinilo
  colores        Json // hex[]
  letraChar      String? // solo elementos-letra
  esNuevo        Boolean @default(false)
  orden          Int     @default(0)
  activo         Boolean @default(false)
  seasonId       String?
  season         SeasonCollection? @relation(fields: [seasonId], references: [id])

  @@index([categoria, activo])
}

model SeasonCollection {
  id          String    @id @default(cuid())
  slug        String    @unique
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  activo      Boolean   @default(true)
  elementos   Element[]
}

model Design {
  id               String  @id @default(cuid())
  userId           String?
  user             User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre           String  @default("Mi funda") @db.VarChar(40)
  deviceId         String
  device           DeviceModel @relation(fields: [deviceId], references: [id])
  caseVariantId    String
  caseVariant      CaseVariant @relation(fields: [caseVariantId], references: [id])
  elementos        Json // PlacedItem[] serializado (§7.2, sin campos de UI)
  precioTotalCache Int // SIEMPRE recalculado en servidor (D9)
  thumbnailUrl     String?
  shareToken       String  @unique // 128 bits CSPRNG, regenerable
  shareNombre      String? @db.VarChar(30)
  publicadoGaleria Boolean @default(false)
  autorVisible     Boolean @default(true)
  likesCount       Int     @default(0) // denormalizado, mantenido transaccionalmente

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     Like[]
  reports   Report[]

  @@index([userId, updatedAt])
  @@index([publicadoGaleria, likesCount])
}

model PresetDesign {
  id             String  @id @default(cuid())
  slug           String  @unique
  nombre         String
  precioCentimos Int // precio CERRADO
  designData     Json // funda + PlacedItem[]
  fotos          Json
  publicado      Boolean @default(false)
  orden          Int     @default(0)
}

model User {
  id              String  @id @default(cuid())
  email           String  @unique
  nombre          String? @db.VarChar(40)
  provider        String // credentials|google|apple
  passwordHash    String? // solo credentials, argon2id
  emailVerificado Boolean @default(false)
  rol             String  @default("user") // user|admin
  deviceId        String?
  // No está en el modelo de §12 pero lo exige §17 ("desactivar cuenta"):
  activo          Boolean @default(true)

  designs   Design[]
  likes     Like[]
  createdAt DateTime @default(now())
}

model Like {
  userId    String
  designId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, designId])
  @@index([designId])
}

model Report {
  id        String   @id @default(cuid())
  designId  String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  motivo    String?
  estado    String   @default("pendiente") // pendiente|revisado|oculto
  createdAt DateTime @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  ownerKey  String // userId o sessionId de invitado
  designId  String?
  presetId  String?
  deviceId  String? // modelo elegido para presets
  cantidad  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([ownerKey])
}

model Settings {
  id                Int     @id @default(1)
  collisionMarginMm Float   @default(0.5)
  heroClaim         String  @default("Diseña tu funda. Pieza a pieza.")
  gridDefault       Boolean @default(false)
}

model AdminAudit {
  id        String   @id @default(cuid())
  adminId   String
  accion    String // create|update|delete|toggle
  entidad   String
  entidadId String
  diff      Json?
  ts        DateTime @default(now())

  @@index([entidad, ts])
}
